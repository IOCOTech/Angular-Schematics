// Color variables for consistency
$error-color: #d32f2f; // Main error color
$background-color: #ffffff; // Light red background
$border-color: #f5c6cb; // Soft border for error
$text-color: #721c24; // Dark red text
$button-color: #c62828; // Darker red for buttons
$button-hover: #b71c1c;
$padding: 16px;

.container {
    background-color: $background-color;
    border: 1px solid $border-color;
    color: $text-color;
    border-radius: 8px;
    padding: $padding;
    max-width: 420px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    font-family: 'Roboto', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 16px;

    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 20px;
        font-weight: 600;
        padding-bottom: 8px;
        border-bottom: 2px solid $border-color;

        .header {
            flex-grow: 1;
        }

        .icon {
            font-size: 24px;
            color: $error-color;
        }
    }

    .content-container {
        text-align: center;

        .error-message {
            font-size: 16px;
            line-height: 1.5;
        }
    }

    .mat-dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 12px;

        .report-issue-button {
            background-color: $button-color;
            color: white;
            font-weight: 500;

            &:hover {
                background-color: $button-hover;
            }
        }

        .ok-button {
            background-color: #555;
            color: white;
            font-weight: 500;

            &:hover {
                background-color: #444;
            }
        }
    }
}
